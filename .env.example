# Copy this file to .env and fill in paths inside your own access-controlled
# research storage. Benchmark images, protocol files, model binaries, derived
# embeddings and any review database must live there, never inside this
# repository. .env is git-ignored and its values are never printed by the
# programme or written into a published result.
#
# Values containing spaces may be quoted with single or double quotes.

# Root containing the extracted dataset image directories (e.g. lfw_funneled/).
FACE_DATA_ROOT=/path/to/research-storage/face-verification/datasets

# Root containing the official pair-protocol files: pairsDevTrain.txt,
# pairsDevTest.txt, pairs.txt and pairs_CPLFW.txt.
FACE_PROTOCOL_ROOT=/path/to/research-storage/face-verification/protocols

# Root of the flat, authors'-distributed raw CPLFW image set (extracted from
# images.rar). Deliberately separate from FACE_DATA_ROOT/cplfw, which would
# hold the non-interchangeable pre-aligned cp-aligned.zip copy instead.
FACE_CPLFW_RAW_ROOT=/path/to/research-storage/face-verification/datasets/cplfw_raw

# Root containing the two pinned OpenCV Zoo model files (.onnx).
FACE_MODEL_ROOT=/path/to/research-storage/face-verification/models

# Optional embedding cache. Leave unset unless you understand that the cache
# would contain biometric templates and can restrict its permissions.
# FACE_CACHE_ROOT=/path/to/research-storage/face-verification/cache
